# Copy to secrets.yaml (git-ignored) and fill in.
# The ESP32 only supports 2.4 GHz Wi-Fi.
wifi_ssid: "your-2.4GHz-ssid"
wifi_password: "your-wifi-password"

# 32 random bytes, base64. Generate one with:
#   python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Home Assistant asks for this key when you add the device.
# It also encrypts over-the-air updates.
hd55_api_key: "REPLACE-WITH-GENERATED-KEY"
